# Every credential and address this project needs, in one file.
#
# Copy to secrets.env, fill it in, and keep that copy in Bitwarden.
# secrets.env is gitignored and must never be committed. It holds the deploy
# key, base64-encoded -- encoded, not encrypted -- so it is exactly as
# sensitive as the key.
#
# The groups go to different places, and which group a value is in is a
# security decision, not a filing convenience:
#
#   DEPLOY_*   -> GitHub Actions *secrets*. CI needs them to reach the server.
#   APP_*      -> GitHub Actions *variables*. Not secret; hostnames and paths.
#   RUNTIME    -> the server's config.toml, over ssh, from your machine only.
#                 Never GitHub. Sign-in: the mail relay and the bootstrap.
#                 Texts to volunteers: the Twilio key.
#
# In order:
#
#   make deploy-keygen          mint the key; install its public half on konsoleH
#   make deploy-known-hosts     pin the server's host key
#   make bootstrap-secret       a one-time secret for the first sign-in
#   make deploy-send-secrets    GitHub secrets and variables, and config.toml
#   make prod-restart           so the app reads the new config.toml
#   make deploy-status          is everything in place? says what is not


# ---------------------------------------------------------------------------
# DEPLOY: how to reach the konsoleH account. Becomes GitHub secrets.
# ---------------------------------------------------------------------------

# The same account as mass-intentions, so the same host and user. The key is
# this project's own: see make deploy-keygen.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=
DEPLOY_SSH_PORT=22

# Paste the line make deploy-keygen prints.
DEPLOY_SSH_KEY_B64=

# Paste the line make deploy-known-hosts prints, after comparing the
# fingerprint with what konsoleH shows.
DEPLOY_KNOWN_HOSTS_B64=

# ---------------------------------------------------------------------------
# APP: where it lives. Becomes GitHub variables. Not secret.
# ---------------------------------------------------------------------------

APP_HOST=stewards.schoenstatt-fathers.us

# The loopback port Apache proxies to. The binary's default and
# deploy/htaccess.template both say 8451; change all three or none.
APP_PORT=8451

# Where the binary, config.toml and the database live, relative to the
# account's home. Must be OUTSIDE public_html: status refuses one inside it.
APP_DIR=stewards

# The docroot for APP_HOST, holding .htaccess and nothing else.
APP_DOCROOT=public_html/stewards.schoenstatt-fathers.us/public

# How many database backups to keep on the server. One is taken on every
# deploy, while the app is stopped.
KEEP_BACKUPS=14


# ---------------------------------------------------------------------------
# RUNTIME: rendered into the server's config.toml. NEVER sent to GitHub.
# ---------------------------------------------------------------------------

# Lets the first steward in without email, once, from /sign-in/first. After
# that it is spent for good: a new value here does not revive it. At least 32
# characters; generate with: make bootstrap-secret
BOOTSTRAP_SIGNIN_SECRET=

# The relay sign-in links go out through. Its own account, not the one
# mass-intentions sends with. Port 587 with STARTTLS; the app will not send
# a password over a connection that is not encrypted, and it does not speak
# implicit TLS on 465.
#
# MAIL_FROM must be an address the relay may send as, on a domain whose SPF
# and DKIM allow it, or the links land in spam and nobody can sign in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Garden stewards

# Texts to volunteers -- sign-up confirmations, reminders, a rain-out call --
# through Twilio. Leave all four empty and the app runs without texts and
# does not ask anyone for a phone number; fill some and not all and the app
# refuses the config, so make deploy-status says so first.
#
# The account is the one eumaeus sends with. The KEY is this app's own: in
# the Twilio console, Account > API keys & tokens > Create API key, type
# Standard, named "stewards". Twilio shows the secret once; it goes here and
# in Bitwarden, nowhere else. A key rather than the account's auth token
# because it can be revoked without touching eumaeus, and a Standard key
# cannot reach the account or mint other keys.
#
# TWILIO_FROM is eumaeus's number for now (decided 2026-10-21), in E.164.
# Sharing it means: replies and STOP go to eumaeus; a STOP stops texts from
# both apps; and these texts sit outside the use case eumaeus's carrier
# registration (A2P 10DLC) describes, so carriers may filter some. A number
# of this app's own, with its own registration, is one change here.
#
# After changing these: make deploy-send-secrets, then make prod-restart,
# then make prod-texts-check to ask Twilio whether the key and the number
# work (it sends nothing), or make prod-texts-check TO=+1... to send your
# own phone one test text and see whether it arrives.
# The binary on the server must already understand [sms] -- deploy first.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM=


# ---------------------------------------------------------------------------
# LOCAL: this machine only. Never leaves it. Read by: scripts/secrets render local
# ---------------------------------------------------------------------------

DEV_ADDR=127.0.0.1:8451
DEV_DB=stewards.db

# What the local config calls the public address. Sign-in links in a
# development run point here, and http is allowed only for this machine.
DEV_BASE_URL=http://127.0.0.1:8451
