#!/usr/bin/env bash
#
# stewards-api METHOD PATH [curl options...]
#
# Calls the garden stewards' API as the steward whose key is in
# STEWARDS_API_KEY, or else in the file STEWARDS_API_KEY_FILE names
# (~/.config/stewards/api-key by default). This is what a steward's own Claude
# uses to add plants and photos; see .claude/skills/stewards-api/SKILL.md.
#
# The file is the way to give Claude Code a key: its shell does not keep
# variables between commands, and the key must not go in secrets.env, which
# agents are never allowed to read (CLAUDE.md §6) and which holds the deploy
# key besides. The file is read here and the key handed to curl; it is never
# printed, so whoever runs this script does not see it either.
#
#   scripts/stewards-api GET /api/v1                       the index: start here
#   scripts/stewards-api GET /api/v1/species
#   scripts/stewards-api PUT /api/v1/species/winecup --json @winecup.json
#   scripts/stewards-api POST /api/v1/species/winecup/photos \
#       -F photo=@leaf.jpg -F kind=leaf -F source=ours
#
# The key is handed to curl on a file descriptor, never on its command line.
# A command line is readable by every process on the machine (ps), and it is
# what lands in shell history and in a Claude transcript. The variable's name
# is what appears in a command, never its value.
#
# STEWARDS_URL points it somewhere else, such as a server on this machine.
# Exits non-zero when the answer is an error, with the answer's JSON printed,
# so that a batch stops at the first refusal and says why.
set -euo pipefail

die() { printf 'stewards-api: %s\n' "$*" >&2; exit 2; }

[ $# -ge 2 ] || die "usage: stewards-api METHOD PATH [curl options...]. Start with: stewards-api GET /api/v1"

method="$1" path="$2"
shift 2

case "$method" in
GET | PUT | POST | PATCH | DELETE) ;;
*) die "$method is not a method the API takes; the index (GET /api/v1) lists them" ;;
esac

case "$path" in
/api/v1 | /api/v1/*) ;;
*) die "$path is not under /api/v1. This only calls the API" ;;
esac

base="${STEWARDS_URL:-https://stewards.schoenstatt-fathers.us}"
base="${base%/}"

curl_opts=(--silent --show-error --fail-with-body --request "$method")

key_file="${STEWARDS_API_KEY_FILE:-$HOME/.config/stewards/api-key}"
if [ -z "${STEWARDS_API_KEY:-}" ] && [ -f "$key_file" ]; then
	# A key file others can read is a key others have. Refused rather than
	# warned about, because the warning is the line nobody reads.
	case "$(stat -c %a "$key_file" 2>/dev/null || stat -f %Lp "$key_file")" in
	600 | 400) ;;
	*) die "$key_file can be read by others. Run: chmod 600 $key_file" ;;
	esac

	STEWARDS_API_KEY="$(tr -d '[:space:]' < "$key_file")"
fi

if [ -z "${STEWARDS_API_KEY:-}" ]; then
	if [ "$path" != /api/v1 ] && [ "$path" != /api/v1/ ]; then
		die "no API key: STEWARDS_API_KEY is not set and $key_file does not exist. A steward makes a key at $base/steward/keys and saves it in that file (chmod 600); it is never written into this repository"
	fi

	exec curl "${curl_opts[@]}" "$@" "$base$path"
fi

# The process substitution is on this line and nowhere earlier: bash closes
# its descriptor when the statement that made it ends, so one made into a
# variable first would be gone before curl could read it.
exec curl "${curl_opts[@]}" --header @<(printf 'Authorization: Bearer %s\n' "$STEWARDS_API_KEY") "$@" "$base$path"
